{
  "name": "furryr.github.io",
  "version": "1.0.0",
  "type": "module",
  "description": "FurryR's personal blog (via vanilla TypeScript).",
  "main": "index.tsx",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,html}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "http-server ./res/ -c-1 -a localhost -p 8080",
    "update-archive": "node scripts/update-archive.js",
    "create-post": "node scripts/create-post.js",
    "list-tag": "node scripts/list-tag.js",
    "list-category": "node scripts/list-category.js",
    "update-runtime": "node scripts/update-runtime.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurryR/furryr.github.io.git"
  },
  "author": "FurryR",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FurryR/furryr.github.io/issues"
  },
  "homepage": "https://github.com/FurryR/furryr.github.io#readme",
  "devDependencies": {
    "enquirer": "^2.4.1",
    "eslint": "^10.4.1",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13"
  }
}
